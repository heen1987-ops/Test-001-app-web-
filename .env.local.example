# 로컬 개발 시 이 파일을 .env.local로 복사해서 값을 채우세요. .env.local은 git에 커밋되지 않습니다.
# Netlify 배포 시에는 이 값들을 Netlify 사이트의 환경변수(서버 전용, NEXT_PUBLIC_ 아님)에 등록합니다.

# GitHub OAuth App (Settings > Developer settings > OAuth Apps 에서 생성)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js 세션 암호화 키 — `npx auth secret` 으로 생성
AUTH_SECRET=

# 로그인을 허용할 단 하나의 GitHub 계정(숫자 ID). heen1987-ops 계정의 ID는 255897129 입니다.
ALLOWED_GITHUB_ID=255897129

# 실제 데이터가 저장될 비공개 저장소. Contents 읽기/쓰기 권한만 가진 fine-grained PAT을 사용하세요.
DATA_REPO_OWNER=heen1987-ops
DATA_REPO_NAME=Test-001-app-data-
DATA_REPO_PAT=
